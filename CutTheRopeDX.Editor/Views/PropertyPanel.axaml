<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CutTheRopeDX.Editor.ViewModels"
             xmlns:loc="using:CutTheRopeDX.Editor.Localization"
             x:Class="CutTheRopeDX.Editor.Views.PropertyPanel"
             x:DataType="vm:EditorViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Panel.Properties}" FontWeight="Bold" Margin="8,8,8,4" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Fields}" Margin="8,0,8,10">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AttributeFieldViewModel">
            <Grid ColumnDefinitions="100,*" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" IsVisible="{Binding EnumValues, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ItemsSource="{Binding EnumValues}"
                        SelectedItem="{Binding Value, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <TextBox Grid.Column="1" IsVisible="{Binding EnumValues, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="{Binding Value, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
